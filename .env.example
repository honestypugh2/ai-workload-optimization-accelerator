# Azure AI Foundry (optional - only needed for real cloud execution)
# Never commit real values. Local benchmark + evaluation run without these.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=

# Azure identity (optional - DefaultAzureCredential is preferred)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Execution mode: local | dry-run | azure
AIWOA_EXECUTION_MODE=local
