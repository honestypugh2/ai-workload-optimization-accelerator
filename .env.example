# Microsoft Foundry (optional - only needed for real cloud execution)
# Never commit real values. Local benchmark + evaluation run without these.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=

# Azure identity (optional - DefaultAzureCredential via `az login` is preferred).
# Leave client id/secret COMMENTED OUT to use your signed-in session / managed
# identity. Do NOT set them to empty strings when using a local .env with
# load_dotenv: empty values make DefaultAzureCredential attempt client-secret
# auth and fail. Uncomment and fill only for an explicit service principal.
AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Model access path: direct (default) | litellm | apim. Leave unset for direct
# inference against the deployment named in FOUNDRY_MODEL_NAME.
AIWOA_GATEWAY_KIND=direct

# Opt-in Foundry agent runtime (default is direct model inference). Set to 1 to
# route each request through the agent runtime instead.
FOUNDRY_USE_AGENT=

# Execution mode: local | dry-run | azure
AIWOA_EXECUTION_MODE=local
